{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "b4c70cc165e94405a90cdc7a8dd15265",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Blur (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -478.9998779296875,
            "y": 212.99996948242188,
            "width": 189.99993896484376,
            "height": 117.99996948242188
        }
    },
    "m_Slots": [
        {
            "m_Id": "f6026ca3ebdb4227a857e77faa031621"
        },
        {
            "m_Id": "c99e629f7c664f5abfb37ec1bf9987f2"
        },
        {
            "m_Id": "69239aa6615d42a99902e889df909f5a"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "Blur",
    "m_FunctionSource": "cead09dfd45843d494a36041c1c8de46",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "void Blur_float(\n    float2 UV,\n    float Blur_strength,\n    out float3 Out)\n{\n    float2 offset = Blur_strength * 0.001;\n    float3 col = float3(0, 0, 0);\n    col += SHADERGRAPH_SAMPLE_SCENE_COLOR(UV + float2(-offset.x, -offset.y));\n    col += SHADERGRAPH_SAMPLE_SCENE_COLOR(UV + float2( 0,        -offset.y));\n    col += SHADERGRAPH_SAMPLE_SCENE_COLOR(UV + float2( offset.x, -offset.y));\n    col += SHADERGRAPH_SAMPLE_SCENE_COLOR(UV + float2(-offset.x,  0       ));\n    col += SHADERGRAPH_SAMPLE_SCENE_COLOR(UV + float2( 0,         0       ));\n    col += SHADERGRAPH_SAMPLE_SCENE_COLOR(UV + float2( offset.x,  0       ));\n    col += SHADERGRAPH_SAMPLE_SCENE_COLOR(UV + float2(-offset.x,  offset.y));\n    col += SHADERGRAPH_SAMPLE_SCENE_COLOR(UV + float2( 0,         offset.y));\n    col += SHADERGRAPH_SAMPLE_SCENE_COLOR(UV + float2( offset.x,  offset.y));\n    Out = col / 9.0;\n}"
}

